{
  "name": "invoice-checker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Checks GST purchase invoices for errors and tampering, and reconciles them with GSTR-2B to find ITC at risk.",
  "engines": { "node": "22.x" },
  "scripts": {
    "predev": "node scripts/prepare-public.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-public.mjs",
    "build": "next build",
    "start": "next start",
    "demo-files": "node --experimental-strip-types scripts/make-demo.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "fflate": "0.8.3",
    "jsqr": "1.4.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "typescript": "7.0.2"
  }
}
